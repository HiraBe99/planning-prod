{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planning prod",
  "version": "1.0.25",
  "identifier": "io.github.hirabe99.planningprod",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Planning prod",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "copyright": "© 2026 HiraBe99. Tous droits réservés.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}